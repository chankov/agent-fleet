  "scripts": {
    "test": "npm run test:fast",
    "test:damage-guard": "cd bin/test/helpers && NODE_OPTIONS=\"--import=$PWD/system1-no-network.js\" node --test --test-timeout=120000 --test-concurrency=2 ../../../.pi/harnesses/agent-hub/damage-guard-*.test.ts ../../../.pi/harnesses/agent-hub/action-authorization.test.ts ../../../.pi/harnesses/agent-hub/approval-wait.test.ts ../../../.pi/harnesses/agent-hub/system1-communication-store.test.ts ../../../.pi/harnesses/agent-hub/spawn-system1-env.test.ts ../../../.pi/harnesses/damage-control-continue/system1-*.test.ts ../../../.pi/harnesses/damage-control-continue/result*.test.ts ../../../.pi/harnesses/damage-control-continue/exemptions.test.js ../../../.pi/harnesses/lib/damage-guard-port.test.ts ../../../.pi/harnesses/lib/damage-guard-loader.test.ts ../../../.pi/harnesses/lib/damage-result-evidence.test.ts ../../../.pi/harnesses/lib/system1/config-damage-guard.test.js ../../../.pi/harnesses/lib/system1/config-v2.test.js ../../../.pi/harnesses/lib/system1/config-context-compaction.test.js ../../../.pi/harnesses/lib/system1/config-example.test.js ../../../.pi/harnesses/lib/system1/payload-screen.test.ts",
    "test:fast": "node bin/test/run-fast.js",
    "test:context-continuity": "node --import ./bin/test/helpers/system1-no-network.js --test --test-timeout=120000 --test-concurrency=2 .pi/harnesses/agent-hub/context-continuity*.test.ts .pi/harnesses/agent-hub/context-compaction*.test.ts .pi/harnesses/lib/system1/config-context-compaction.test.js .pi/harnesses/agent-hub/lifecycle/lifecycle.test.ts .pi/harnesses/agent-hub/policy/work-mode.test.ts .pi/harnesses/agent-hub/context/budgets.test.ts .pi/harnesses/agent-hub/tools/action-executors.test.ts .pi/harnesses/agent-hub/budget-continuation.integration.test.ts .pi/harnesses/agent-hub/context/assertion-journal.test.ts .pi/harnesses/agent-hub/assertion-ledger-reload.integration.test.ts",
    "test:damage-relay": "node --import ./bin/test/helpers/system1-no-network.js --experimental-strip-types --test --test-timeout=120000 .pi/agent-fleet/scripts/fleet-codex-permissions.integration.test.ts .pi/agent-fleet/scripts/fleet-codex-desktop-queue.test.ts .pi/agent-fleet/scripts/fleet-codex-catalog-readiness.test.ts .pi/agent-fleet/scripts/fleet-codex-event-*.test.ts .pi/agent-fleet/scripts/fleet-codex-relay-latency.test.ts .pi/harnesses/lib/damage-control-shared.test.ts .pi/harnesses/agent-hub/permission*.test.ts .pi/harnesses/agent-hub/access-approval-isolation.test.ts .pi/harnesses/lib/damage-auto-policy.test.ts .pi/harnesses/lib/damage-control-presentation.test.ts .pi/harnesses/lib/fleet-codex-event-bridge.test.ts .pi/harnesses/lib/damage-guard-loader.test.ts",
    "test:full": "npm run test:fast && npm run test:damage-relay && npm run typecheck:workflows && npm run typecheck:hub && npm run test:agentic && npm run typecheck:system1 && npm run test:file-discovery -- .pi/harnesses/agent-hub/dispatch-triage.test.ts && npm run test:system1:service && npm run test:task-triage && npm run test:task-triage-pilot && node bin/cli.js --version && node bin/cli.js --help && node --test --test-timeout=120000 bin/test/setup-tty.test.js && node bin/test/run-full.js && npm run test:watchdog-py",
    "test:task-triage": "node --import ./bin/test/helpers/system1-no-network.js --experimental-strip-types --test --test-timeout=120000 .pi/harnesses/agent-hub/task-triage-config.test.ts .pi/harnesses/agent-hub/task-triage-state.test.ts .pi/harnesses/agent-hub/task-triage-policy.test.ts .pi/harnesses/agent-hub/task-triage-obligations.test.ts .pi/harnesses/agent-hub/task-triage-authorization.test.ts .pi/harnesses/agent-hub/action-presentation-regression.test.ts .pi/harnesses/agent-hub/task-triage-runtime.test.ts .pi/harnesses/agent-hub/task-triage-effects.integration.test.ts .pi/harnesses/agent-hub/task-triage-pressure.integration.test.ts .pi/harnesses/agent-hub/task-triage-persisted-compaction.integration.test.ts .pi/harnesses/agent-hub/task-triage-real-pi.integration.test.ts",
    "test:triage": "node --import ./bin/test/helpers/system1-no-network.js --test --test-timeout=120000 .pi/harnesses/agent-hub/dispatch-triage.test.ts .pi/harnesses/agent-hub/system1-communication-store.test.ts .pi/harnesses/agent-hub/ui/system1-communication.test.ts",
    "test:task-triage-pilot": "tsc --noEmit -p bin/test/helpers/task-triage-pilot-tsconfig.json && node --import ./bin/test/helpers/system1-no-network.js --test --test-timeout=120000 bin/test/task-triage-pilot-budget.test.ts bin/test/task-triage-pilot.test.ts",
    "test:agentic": "node --import ./bin/test/helpers/system1-no-network.js --test --test-timeout=120000 .pi/harnesses/lib/system1/config-agentic.test.js .pi/harnesses/agent-hub/agentic*.test.ts",
    "test:system1": "npm run test:agentic && npm run test:triage && npm run typecheck:system1 && node --test --test-timeout=120000 .pi/harnesses/lib/system1/config*.test.js && npm run test:system1:service",
    "test:system1:service": "node --experimental-strip-types --test --test-timeout=120000 .pi/harnesses/lib/system1/service.test.ts .pi/harnesses/lib/system1/fake-provider.test.ts .pi/harnesses/lib/system1/jev.test.ts .pi/harnesses/lib/system1/demo.test.ts",
    "test:portability": "node bin/test/helpers/run-portability.js",
    "typecheck:workflows": "tsc -p .pi/agent-fleet/scripts/workflows/tsconfig.json --noEmit",
    "typecheck:hub": "tsc -p .pi/harnesses/agent-hub/tsconfig.json --noEmit",
    "typecheck:codex-bootstrap": "npm run typecheck:hub && tsc -p bin/test/helpers/codex-bootstrap-tsconfig.json --noEmit",
    "typecheck:system1": "tsc --noEmit --strict --allowJs --checkJs --target ES2022 --module NodeNext --moduleResolution NodeNext --allowImportingTsExtensions --types node .pi/harnesses/lib/system1/config.js .pi/harnesses/lib/system1/contracts.ts .pi/harnesses/lib/system1/service.ts .pi/harnesses/lib/system1/jev.ts .pi/harnesses/lib/system1/demo.ts .pi/harnesses/lib/system1/service.test.ts .pi/harnesses/lib/system1/fake-provider.test.ts .pi/harnesses/lib/system1/jev.test.ts .pi/harnesses/lib/system1/demo.test.ts",
    "test:watchdog-py": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s .pi/agent-fleet/hermes/watchdog-tests -p 'test_*.py'",
    "pack:dry": "npm pack --dry-run",
    "changeset": "changeset",
    "build:manifest": "node bin/build-manifest.js",
    "check:manifest": "node bin/build-manifest.js --check",
    "version:changeset": "node bin/force-patch-changesets.js && changeset version && node bin/sync-harness-versions.js && npm install --package-lock-only --ignore-scripts --no-audit --no-fund && node bin/build-manifest.js && node bin/snapshot-version.js",
    "release": "changeset publish",
    "test:file-discovery": "node --import ./bin/test/helpers/system1-no-network.js --test --test-concurrency=2 --test-timeout=120000 .pi/harnesses/lib/system1/config-file-discovery.test.js .pi/harnesses/lib/system1/config-v2.test.js .pi/harnesses/agent-hub/file-discovery/*.test.ts .pi/harnesses/agent-hub/spawn-system1-env.test.ts .pi/harnesses/agent-hub/system1-communication-store.test.ts .pi/harnesses/agent-hub/ui/system1-communication.test.ts",
    "test:fleet-native": "node --test --test-timeout=120000 .pi/agent-fleet/scripts/fleet-codex*.test.ts"
  },
